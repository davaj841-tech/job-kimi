{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "davaj841-tech/job-kimi",
    "type": "project",
    "description": "پلتفرم فارسی آزمون آنلاین استخدامی با PWA، فروشگاه PDF، رزومه‌ساز AI و سیستم اشتراک",
    "keywords": ["laravel", "vue", "pwa", "exam", "iran", "rtl", "job", "recruitment"],
    "homepage": "https://github.com/davaj841-tech/job-kimi",
    "readme": "README.md",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^3.1",
        "filament/filament": "^3.2",
        "knuckleswtf/scribe": "^5.11",
        "laravel/framework": "^11.31",
        "laravel/horizon": "^5.48",
        "laravel/pulse": "^1.8",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^2.9",
        "maatwebsite/excel": "^3.1",
        "morilog/jalali": "^3.5",
        "predis/predis": "^3.5",
        "sentry/sentry-laravel": "^4.27",
        "spatie/laravel-medialibrary": "^11.23",
        "spatie/laravel-permission": "^6.25"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/pail": "^1.1",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "laravel/telescope": "^5.22",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "phpstan": [
            "@php vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "test": [
            "@php artisan test"
        ],
        "prod-optimize": [
            "@php artisan config:cache",
            "@php artisan route:cache",
            "@php artisan view:cache",
            "@php artisan event:cache",
            "@php artisan optimize"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "audit": {
            "block-insecure": false
        },
        "platform-check": false,
        "platform": {
            "php": "8.2.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

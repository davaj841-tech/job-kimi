{
  "openapi": "3.0.3",
  "info": {
    "title": "JobAzmoon API",
    "description": "REST API documentation for JobAzmoon (v1)",
    "version": "1.0.0"
  },
  "servers": [{ "url": "/api/v1", "description": "API v1" }],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Sanctum"
      }
    },
    "schemas": {
      "Success": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" },
          "data": {}
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "message": { "type": "string" },
          "errors": {}
        }
      }
    },
    "responses": {
      "Unauthorized": { "description": "Unauthenticated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Forbidden": { "description": "Forbidden", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Validation": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "ServerError": { "description": "Server error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    }
  },
  "paths": {
    "/auth/otp/send": {
      "post": {
        "tags": ["Auth"],
        "summary": "Send OTP",
        "description": "Send login OTP to mobile number",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mobile"],
                "properties": {
                  "mobile": { "type": "string", "example": "09123456789" },
                  "turnstile_token": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "OTP sent", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Success" } } } },
          "422": { "$ref": "#/components/responses/Validation" },
          "429": { "description": "Rate limited" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/auth/otp/verify": {
      "post": {
        "tags": ["Auth"],
        "summary": "Verify OTP",
        "description": "Verify OTP and receive Sanctum token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mobile", "code"],
                "properties": {
                  "mobile": { "type": "string" },
                  "code": { "type": "string" },
                  "turnstile_token": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login success with token", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Success" } } } },
          "422": { "$ref": "#/components/responses/Validation" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/auth/forgot-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Forgot password",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["email"], "properties": { "email": { "type": "string", "format": "email" } } } } }
        },
        "responses": {
          "200": { "description": "Reset link sent", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Success" } } } },
          "422": { "$ref": "#/components/responses/Validation" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Current user",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "User profile", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Success" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Logout",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Logged out" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/exams": {
      "get": {
        "tags": ["Exams"],
        "summary": "List exams",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Exam list" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["Exams"],
        "summary": "Create exam (admin/operator)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "201": { "description": "Created" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "$ref": "#/components/responses/Validation" }
        }
      }
    },
    "/exams/{slug}": {
      "get": {
        "tags": ["Exams"],
        "summary": "Exam detail",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Exam" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/exams/{id}/start": {
      "post": {
        "tags": ["Exams"],
        "summary": "Start exam attempt",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "201": { "description": "Attempt started" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/exams/{id}/submit/{attemptId}": {
      "post": {
        "tags": ["Exams"],
        "summary": "Submit exam answers",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "attemptId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Score result" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "422": { "$ref": "#/components/responses/Validation" } }
      }
    },
    "/wallet": {
      "get": {
        "tags": ["Payment"],
        "summary": "Wallet balance & recent transactions",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Wallet" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/wallet/charge": {
      "post": {
        "tags": ["Payment"],
        "summary": "Charge wallet via ZarinPal",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["amount"], "properties": { "amount": { "type": "integer", "example": 100000 } } } } }
        },
        "responses": { "200": { "description": "payment_url returned" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "422": { "$ref": "#/components/responses/Validation" } }
      }
    },
    "/wallet/verify": {
      "get": {
        "tags": ["Payment"],
        "summary": "Verify wallet charge (gateway callback)",
        "parameters": [
          { "name": "Authority", "in": "query", "schema": { "type": "string" } },
          { "name": "Status", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Verified" }, "400": { "description": "Failed" } }
      }
    },
    "/subscription/subscribe": {
      "post": {
        "tags": ["Payment"],
        "summary": "Purchase subscription",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "content": { "application/json": { "schema": { "type": "object", "required": ["plan_id", "payment_method"], "properties": { "plan_id": { "type": "integer" }, "payment_method": { "type": "string", "enum": ["wallet", "zarinpal"] }, "coupon_code": { "type": "string" } } } } }
        },
        "responses": { "200": { "description": "Subscribed or redirect" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "400": { "description": "Payment error" } }
      }
    },
    "/coupons/validate": {
      "post": {
        "tags": ["Coupons"],
        "summary": "Validate coupon code",
        "requestBody": {
          "content": { "application/json": { "schema": { "type": "object", "required": ["code", "amount", "type"], "properties": { "code": { "type": "string" }, "amount": { "type": "integer" }, "type": { "type": "string", "enum": ["subscription", "pdf"] } } } } }
        },
        "responses": { "200": { "description": "Valid" }, "422": { "$ref": "#/components/responses/Validation" } }
      }
    },
    "/search": {
      "get": {
        "tags": ["Search"],
        "summary": "Global search",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "type", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Grouped results" } }
      }
    },
    "/search/suggestions": {
      "get": {
        "tags": ["Search"],
        "summary": "Search autocomplete suggestions",
        "parameters": [{ "name": "q", "in": "query", "required": true, "schema": { "type": "string", "minLength": 2 } }],
        "responses": { "200": { "description": "Top 5 per type" } }
      }
    },
    "/admin/dashboard-stats": {
      "get": {
        "tags": ["Admin"],
        "summary": "Dashboard statistics",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Stats" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/admin/analytics/visits": {
      "get": {
        "tags": ["Admin"],
        "summary": "Visit analytics",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "date_from", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "date_to", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "group_by", "in": "query", "schema": { "type": "string", "enum": ["day", "hour"] } }
        ],
        "responses": { "200": { "description": "Visit series" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/admin/analytics/top-pages": {
      "get": {
        "tags": ["Admin"],
        "summary": "Top pages",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Top pages" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/admin/analytics/devices": {
      "get": {
        "tags": ["Admin"],
        "summary": "Device breakdown",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Devices" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/admin/backups": {
      "get": {
        "tags": ["Admin"],
        "summary": "List backups",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Backup list" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      },
      "post": {
        "tags": ["Admin"],
        "summary": "Trigger backup job",
        "security": [{ "bearerAuth": [] }],
        "responses": { "202": { "description": "Queued" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      },
      "delete": {
        "tags": ["Admin"],
        "summary": "Delete backup",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "path", "in": "query", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Deleted" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/admin/audit-logs": {
      "get": {
        "tags": ["Admin"],
        "summary": "Audit logs",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "user_id", "in": "query", "schema": { "type": "integer" } },
          { "name": "action", "in": "query", "schema": { "type": "string" } },
          { "name": "entity_type", "in": "query", "schema": { "type": "string" } },
          { "name": "date_from", "in": "query", "schema": { "type": "string" } },
          { "name": "date_to", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Paginated logs" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/admin/users": {
      "get": {
        "tags": ["Admin"],
        "summary": "List users",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Users" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      }
    },
    "/admin/settings": {
      "get": {
        "tags": ["Admin"],
        "summary": "Get settings",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Settings groups" }, "403": { "$ref": "#/components/responses/Forbidden" } }
      },
      "put": {
        "tags": ["Admin"],
        "summary": "Update settings",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Updated" }, "403": { "$ref": "#/components/responses/Forbidden" }, "422": { "$ref": "#/components/responses/Validation" } }
      }
    }
  }
}

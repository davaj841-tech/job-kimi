APP_NAME=JobAzmoon
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://jobazmoon.ir
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jobazmoon
DB_USERNAME=jobazmoon
DB_PASSWORD=

# --- Shared cPanel / no Redis (default for installer & shared hosting) ---
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database

# Pulse is noisy / unused on shared hosting — keep off unless you operate Pulse UI
PULSE_ENABLED=false
PULSE_SERVERS_ENABLED=false

# --- VPS + Redis (optional; requires Redis server + Horizon/queue worker) ---
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
# SESSION_DRIVER=redis

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.jobazmoon.ir
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=jobazmoon.ir,www.jobazmoon.ir

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
# Laravel 12 / Symfony: smtp (STARTTLS, port 587) or smtps (implicit TLS, port 465)
MAIL_SCHEME=null
# cPanel: usually mail.YOURDOMAIN.ir or the host shown in Email Accounts → Connect Devices
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=15
MAIL_FROM_ADDRESS=noreply@jobazmoon.ir
MAIL_FROM_NAME="جاب‌آزمون"
# Test after deploy: php artisan mail:test you@example.com --force

# Payments (Admin Settings override ZARINPAL_MERCHANT_ID when filled)
PAYMENT_GATEWAY=zarinpal
PAYMENT_FAKE=false
PAYMENT_PENDING_TTL_MINUTES=45
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
ZARINPAL_TIMEOUT=15
ZARINPAL_CURRENCY=IRR
NEXTPAY_API_KEY=
IDPAY_API_KEY=
IDPAY_SANDBOX=false
MELLAT_TERMINAL_ID=
MELLAT_USERNAME=
MELLAT_PASSWORD=
PARSIAN_PIN=
SAMAN_TERMINAL_ID=
PASARGAD_MERCHANT_CODE=
PASARGAD_TERMINAL_CODE=
PASARGAD_PRIVATE_KEY=
SADAD_MERCHANT_ID=
SADAD_TERMINAL_ID=
SADAD_TERMINAL_KEY=
AP_USERNAME=
AP_PASSWORD=
AP_MERCHANT_CONFIG_ID=

# SMS — required in production (log fallback is off)
SMS_ENABLED=true
SMS_GATEWAY=melipayamak
SMS_ALLOW_LOG_FALLBACK=false
SMS_ALLOW_LEGACY_PLAINTEXT_OTP=false
SMS_TIMEOUT=10
SMS_OTP_TEMPLATE="کد تایید جاب‌آزمون: {code}"
KAVENEGAR_API_KEY=
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_FROM=
MELIPAYAMAK_API_URL=https://rest.payamak-panel.com/api/SendSMS
MELIPAYAMAK_PATTERN_BODY_ID=
MELIPAYAMAK_PATTERN_TEXT="{code}"

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

CONTENT_ENABLED=false
CONTENT_DAILY_GENERATION_ENABLED=false
CONTENT_SYSTEM_AUTHOR_ID=

# Cloudflare Turnstile — Secret ONLY here (not Admin Settings / not frontend).
# Enable in Admin → security → «فعال بودن Turnstile» after setting secret.
TURNSTILE_SITE_KEY=0x4AAAAAAEiAUvpbmcvevZFU
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=false
# Production hostnames (comma-separated). APP_URL host is also allowed.
TURNSTILE_HOSTNAMES=
TURNSTILE_TIMEOUT=10
TURNSTILE_MAX_TOKEN_AGE=300

FILAMENT_PATH=filament

# Behind Nginx on same host: 127.0.0.1,::1
# Behind Cloudflare (or only reachable via trusted proxy): set CF CIDRs or *
TRUSTED_PROXIES=127.0.0.1,::1
TRUSTED_PROXIES_V6=

TELESCOPE_ENABLED=false
HORIZON_ALLOWED_EMAILS=admin@jobazmoon.ir

# Required for php artisan db:seed (AdminUserSeeder). Idempotent by mobile.
# Example: ADMIN_SEED_MOBILE=09121234567
ADMIN_SEED_USERNAME=
ADMIN_SEED_MOBILE=
ADMIN_SEED_EMAIL=
# Optional (min 8). If empty, a one-time password is generated and printed once — save it.
# Never commit real passwords. Change after first login.
ADMIN_SEED_PASSWORD=

DEPLOY_SECRET=

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

BACKUP_DIR=/var/backups/jobazmoon
BACKUP_KEEP_DAYS=7
BACKUP_S3_URI=
BACKUP_DISK=
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=

VITE_APP_NAME="${APP_NAME}"
VITE_SENTRY_DSN=

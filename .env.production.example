APP_NAME=JobAzmoon
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://jobazmoon.ir
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jobazmoon
DB_USERNAME=jobazmoon
DB_PASSWORD=

# --- VPS + Redis (recommended) ---
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# --- Shared hosting alternative (uncomment & disable Redis block above) ---
# QUEUE_CONNECTION=database
# CACHE_STORE=database
# SESSION_DRIVER=database

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.jobazmoon.ir
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=jobazmoon.ir,www.jobazmoon.ir

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@jobazmoon.ir
MAIL_FROM_NAME="جاب‌آزمون"

# Payments (Admin Settings override these when filled)
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
NEXTPAY_API_KEY=
IDPAY_API_KEY=
IDPAY_SANDBOX=false

# SMS — required in production (log fallback is off)
KAVENEGAR_API_KEY=
SMS_GATEWAY=kavenegar
SMS_ALLOW_LOG_FALLBACK=false
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_FROM=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

CONTENT_ENABLED=false
CONTENT_DAILY_GENERATION_ENABLED=false
CONTENT_SYSTEM_AUTHOR_ID=

# Cloudflare Turnstile (also Admin → security). Used as fallback when Settings empty.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

FILAMENT_PATH=filament

# Behind Nginx on same host: 127.0.0.1,::1
# Behind Cloudflare (or only reachable via trusted proxy): set CF CIDRs or *
TRUSTED_PROXIES=127.0.0.1,::1
TRUSTED_PROXIES_V6=

TELESCOPE_ENABLED=false
HORIZON_ALLOWED_EMAILS=admin@jobazmoon.ir

# Optional: password used by AdminUserSeeder (min 8). Change after first login.
ADMIN_SEED_PASSWORD=

DEPLOY_SECRET=

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

BACKUP_DIR=/var/backups/jobazmoon
BACKUP_KEEP_DAYS=7
BACKUP_S3_URI=
BACKUP_DISK=
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=

VITE_APP_NAME="${APP_NAME}"
VITE_SENTRY_DSN=

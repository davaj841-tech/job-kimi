APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_INSTALLED=false
APP_TIMEZONE=Asia/Tehran
APP_URL=http://localhost

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Optional: only used with `php artisan serve --no-reload` (multi-worker dev server).
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jobazmoon
DB_USERNAME=root
DB_PASSWORD=

# Local default: database. Production recommendation: redis (requires Redis server + predis).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:8000
# Comma-separated. In production, set this to your public origin(s). Empty uses APP_URL.
# CORS_ALLOWED_ORIGINS=https://jobazmoon.ir
# Token lifetime in minutes (default 30 days). Leave unset to use the app default.
# SANCTUM_TOKEN_EXPIRATION=43200

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Laravel Pulse — off by default on shared hosting (enable only if needed)
PULSE_ENABLED=false
PULSE_SERVERS_ENABLED=false

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis is installed via composer (predis/predis). Use REDIS_CLIENT=predis unless phpredis ext is installed.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# --- Production Redis example (uncomment when Redis is available) ---
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# REDIS_QUEUE=default

MAIL_MAILER=smtp
# Symfony Mailer schemes: smtp (STARTTLS / port 587) or smtps (implicit TLS / port 465).
# Do NOT set tls/ssl here — those are Settings "encryption" labels, mapped at runtime.
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=15
MAIL_FROM_ADDRESS="noreply@jobazmoon.ir"
MAIL_FROM_NAME="جاب‌آزمون"
# SMTP can also be configured via Admin Settings (mail group)

# Payments — Merchant ID from env; Admin Settings override when filled
PAYMENT_GATEWAY=zarinpal
PAYMENT_FAKE=false
PAYMENT_PENDING_TTL_MINUTES=45
MIN_WALLET_CHARGE=10000
MAX_WALLET_CHARGE=50000000
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_TIMEOUT=15
ZARINPAL_CURRENCY=IRR
# ZARINPAL_BASE_URL=https://payment.zarinpal.com
# ZARINPAL_SANDBOX_BASE_URL=https://sandbox.zarinpal.com
NEXTPAY_API_KEY=
IDPAY_API_KEY=
IDPAY_SANDBOX=true
MELLAT_TERMINAL_ID=
MELLAT_USERNAME=
MELLAT_PASSWORD=
SHAPARAK_TERMINAL_ID=
SHAPARAK_USERNAME=
SHAPARAK_PASSWORD=

# Idempotency key retry settings
IDEMPOTENCY_LOCK_TIMEOUT=10
IDEMPOTENCY_CACHE_TTL=3600

# SMS — env is fallback if Admin Settings are empty
# Production: set credentials; keep SMS_ALLOW_LOG_FALLBACK=false
# Without credentials + fallback=false, registration OTP returns 503.
# OTP needs approved MELIPAYAMAK_PATTERN_BODY_ID and/or MELIPAYAMAK_FROM for plain fallback.
SMS_ENABLED=true
SMS_PROVIDER=melipayamak
SMS_GATEWAY=melipayamak
SMS_ALLOW_LOG_FALLBACK=true
SMS_ALLOW_LEGACY_PLAINTEXT_OTP=false
SMS_TIMEOUT=10
SMS_OTP_ENABLED=true
SMS_TRANSACTIONAL_ENABLED=true
SMS_MARKETING_ENABLED=false
SMS_QUEUE_ENABLED=true
SMS_QUEUE_TRIES=3
SMS_QUEUE_BACKOFF=30,120,300
SMS_OTP_LENGTH=5
SMS_OTP_EXPIRES_MINUTES=3
SMS_OTP_RESEND_COOLDOWN=60
SMS_OTP_DAILY_LIMIT=10
SMS_OTP_MAX_VERIFY_ATTEMPTS=5
SMS_OTP_LOCKOUT_MINUTES=15
SMS_OTP_TEMPLATE="کد تایید جاب‌آزمون: {code}"
SMS_LOG_ENABLED=true
KAVENEGAR_API_KEY=
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_FROM=
MELIPAYAMAK_API_URL=https://rest.payamak-panel.com/api/SendSMS
MELIPAYAMAK_PATTERN_BODY_ID=
MELIPAYAMAK_PATTERN_TEXT="{code}"

# AI (also configurable via Admin Settings) — separate from template content generator
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# Automated Content Generator (template-based Persian articles from approved JobPosts — no AI)
CONTENT_ENABLED=false
CONTENT_DAILY_GENERATION_ENABLED=false
CONTENT_DAILY_GENERATION_TIME=09:00
CONTENT_TIMEZONE=Asia/Tehran
CONTENT_PUBLISH_MODE=draft
CONTENT_MINIMUM_LENGTH=280
CONTENT_MINIMUM_FACTUAL_SCORE=3
CONTENT_MAX_ARTICLES_PER_DAY=1
CONTENT_LOOKBACK_DAYS=14
CONTENT_ALLOWED_RELIABILITY=official,highly_trusted,trusted
CONTENT_QUEUE=default
CONTENT_SYNC_TO_BLOG=true
CONTENT_BLOG_CATEGORY=استخدام
CONTENT_SYSTEM_AUTHOR_ID=

# Cloudflare Turnstile
# Site Key is public (widget). Default may be set in config/services.php.
TURNSTILE_SITE_KEY=
# Secret ONLY in .env — never commit, never put in Admin Settings / frontend.
TURNSTILE_SECRET_KEY=
# Optional bootstrap when DB setting turnstile_enabled is unset (true/false)
TURNSTILE_ENABLED=false
# Comma-separated hostnames allowed in siteverify (APP_URL host is always added)
TURNSTILE_HOSTNAMES=
TURNSTILE_TIMEOUT=10
TURNSTILE_MAX_TOKEN_AGE=300

# Filament admin panel path (moved off /admin for Vue SPA)
FILAMENT_PATH=filament

# Trust badges — paste official values from enamad.ir panel (id/Code are public in HTML)
ENAMAD_ENABLED=false
ENAMAD_ID=
ENAMAD_CODE=
ENAMAD_URL=
SAMANDEHI_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Shell + app backup (see BACKUP-RESTORE.md)
BACKUP_DIR=/var/backups/jobazmoon
BACKUP_S3_URI=
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_COUNT=7
BACKUP_RESTORE_MAX_KB=512000
BACKUP_DISK=
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=

TELESCOPE_ENABLED=true
HORIZON_ALLOWED_EMAILS=

VITE_APP_NAME="${APP_NAME}"

# Trusted proxies (Cloudflare CIDRs). Leave empty locally; set in production.
TRUSTED_PROXIES=
TRUSTED_PROXIES_V6=

# Transaction settings
DB_TRANSACTION_ATTEMPTS=3
DB_TRANSACTION_ISOLATION="REPEATABLE READ"
DB_LOCK_WAIT_TIMEOUT=10

# Required by AdminUserSeeder (db:seed). Idempotent upsert by mobile.
ADMIN_SEED_USERNAME=
ADMIN_SEED_MOBILE=
ADMIN_SEED_EMAIL=
# Optional (min 8). If empty/short, a one-time password is generated and printed to console.
ADMIN_SEED_PASSWORD=


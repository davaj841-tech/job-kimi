{
  "name": "job-kimi",
  "private": true,
  "description": "JobAzmoon Frontend — Vue 3 PWA for Iranian job exam preparation",
  "repository": {
    "type": "git",
    "url": "https://github.com/davaj841-tech/job-kimi.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint \"resources/js/**/*.{ts,vue}\"",
    "lint:fix": "eslint \"resources/js/**/*.{ts,vue}\" --fix",
    "format": "prettier --write \"resources/js/**/*.{ts,vue,css}\"",
    "format:check": "prettier --check \"resources/js/**/*.{ts,vue,css}\"",
    "icons:generate": "node scripts/generate-pwa-icons.js",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "screenshots": "node scripts/generate-screenshots.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@pinia/testing": "^0.1.7",
    "@testing-library/vue": "^8.1.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.10",
    "@types/screenfull": "^4.0.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-vue": "5.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.4.20",
    "axios": "^1.7.4",
    "concurrently": "^9.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "laravel-vite-plugin": "^1.2.0",
    "lint-staged": "^16.4.0",
    "playwright": "^1.62.1",
    "postcss": "^8.4.47",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.0.11",
    "vite-plugin-pwa": "0.21.1",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.8"
  },
  "dependencies": {
    "@fontsource-variable/estedad": "^5.3.0",
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "@sentry/vue": "^10.69.0",
    "@vueuse/core": "12.5.0",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.5.1",
    "gsap": "^3.15.0",
    "katex": "^0.18.1",
    "pdfjs-dist": "^6.2.108",
    "pinia": "2.3.1",
    "screenfull": "^6.0.2",
    "sortablejs": "^1.15.7",
    "vue": "3.5.13",
    "vue-chartjs": "^5.3.4",
    "vue-router": "4.5.0"
  }
}

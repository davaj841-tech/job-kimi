* text=auto

*.php text eol=lf
*.sh text eol=lf
*.vue text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.css text eol=lf
*.md text eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

# linguist overrides
*.blade.php linguist-language=PHP
resources/js/* linguist-language=Vue
public/* linguist-vendored
vendor/* linguist-vendored
node_modules/* linguist-vendored
cpanel-installer/package/** linguist-vendored

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
